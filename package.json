{
  "name": "myanglish",
  "version": "0.1.0",
  "description": "Myanmar (Burmese) to English-letter URL slugs: phonetic romanization, zero dependencies",
  "keywords": [
    "myanmar",
    "burmese",
    "slug",
    "slugify",
    "romanization",
    "transliteration",
    "unicode"
  ],
  "license": "MIT",
  "author": "Hein Soe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hheinsoee/myanglish.git"
  },
  "homepage": "https://github.com/hheinsoee/myanglish#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
